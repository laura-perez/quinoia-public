/debug/

# Supabase local
/supabase/.temp/
/supabase/.branches/
/supabase/volumes/

# editor and agent-local settings
.vscode/
.claude/settings.local.json

# TypeScript incremental build info
*.tsbuildinfo

# local working notes (not part of the project)
market-study-data.md
