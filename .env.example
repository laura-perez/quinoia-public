# Copy to .env.local and fill in real values. Never commit .env.local.
# Server variables are validated by src/lib/config/env.ts when the config module loads (a missing
# or malformed required variable throws an error). Client variables (NEXT_PUBLIC_*) are inlined into the browser bundle.

# --- App ---------------------------------------------------------------------
# Public base URL, used to build magic links and Stripe redirect URLs
APP_BASE_URL=http://localhost:3000

# --- Supabase (server-side only) ---------------------------------------------
SUPABASE_URL=
# service_role key: bypasses RLS, must never reach the browser
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com
# Optional: recipient of admin alerts (form submission errors, insufficient recipes).
# When unset, alerts are skipped with a logged warning.
ADMIN_EMAIL=

# --- reCAPTCHA v3 ------------------------------------------------------------
RECAPTCHA_SECRET_KEY=
# Client-side site key (expected format: 40 characters starting with "6L")
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Stripe (use test-mode keys) ---------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_MONTHLY_PROMO=price_
STRIPE_PRICE_YEARLY=price_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# --- Rate limiting (optional) ------------------------------------------------
# Without these, src/lib/auth/rateLimits.ts runs in no-op mode (every request allowed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Recipe images (optional) ------------------------------------------------
# Set to "true" if the recipes_photos bucket is public; otherwise signed URLs are used
NEXT_PUBLIC_RECIPES_PHOTOS_PUBLIC=false
NEXT_PUBLIC_SUPABASE_URL=

# --- Logging (optional) ------------------------------------------------------
# Force debug logs in production, and sample them (0.0 to 1.0)
ENABLE_DEBUG_LOGS=false
DEBUG_SAMPLE_RATE=1.0
